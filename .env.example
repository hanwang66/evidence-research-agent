FIRECRAWL_KEY="YOUR_KEY"
FIRECRAWL_CONCURRENCY="2"
# FIRECRAWL_BASE_URL="http://localhost:3002"

OPENAI_KEY="YOUR_KEY"
CUSTOM_MODEL="gpt-4o-mini"
# OPENAI_ENDPOINT="http://localhost:11434/v1"

# Provider timeout and retry policy.
PROVIDER_TIMEOUT_SECONDS="30"
MODEL_TIMEOUT_SECONDS="60"
PROVIDER_MAX_RETRIES="2"
PROVIDER_RETRY_BASE_DELAY="0.5"

# Global limits shared by all recursive research branches.
RESEARCH_MAX_SEARCHES="20"
RESEARCH_MAX_MODEL_CALLS="40"
RESEARCH_MAX_SECONDS="180"

CONTEXT_SIZE="128000"
RESEARCH_DB_PATH="data/research.db"

# If you want to use fireworks.ai's DeepSeek R1 model:
# FIREWORKS_KEY="YOUR_KEY"
